NODE_ENV=production
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://saylotto:CHANGE_ME@127.0.0.1:5432/saylotto

# Exact frontend origins allowed to call the API.
CORS_ORIGINS=https://lottokos.pages.dev
FRONTEND_URL=https://lottokos.pages.dev

# Long random value used only for protected admin endpoints.
ADMIN_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Draw settings
TIMEZONE=Europe/Berlin
DRAW_HOUR=18
DRAW_MINUTE=0
CUTOFF_HOUR=17
CUTOFF_MINUTE=55
STARTING_JACKPOT=1000000

# Prize-pool shares. Must add up to 1.0.
PRIZE_SHARE_6=0.50
PRIZE_SHARE_5=0.25
PRIZE_SHARE_4=0.15
PRIZE_SHARE_3=0.10

SESSION_DAYS=30
COOKIE_NAME=__Host-saylotto_session
